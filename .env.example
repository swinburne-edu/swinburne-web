# Local (Windows + Laragon)
DATABASE_URL=postgres://swin:CHANGE_ME@127.0.0.1:5432/swin
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MEDIA_DIR=./media
# Đặt "true" ở staging để chặn index (robots + header X-Robots-Tag)
NOINDEX=false
# Chạy Payload Jobs (retry CRM) trong process này. PM2 cluster: chỉ instance 0 chạy.
JOBS_AUTORUN=true

CRM_API_URL=
CRM_API_TOKEN=
ALERT_EMAIL=

# Turnstile: để trống ở local sẽ dùng test key luôn-pass của Cloudflare
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@swinburne-vn.edu.vn

# Chỉ dùng ở giai đoạn migrate (MySQL của Laragon)
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_NAME=swin_wp
WP_DB_USER=root
WP_DB_PASSWORD=
WP_DB_PREFIX=wp_
WP_UPLOADS_DIR=C:\laragon\www\swin-wp\wp-content\uploads

# Test tích hợp (Vitest) dùng DB riêng
TEST_DATABASE_URL=postgres://swin:CHANGE_ME@127.0.0.1:5432/swin_test
