{
  "name": "swinburne-vn",
  "version": "0.1.0",
  "private": true,
  "description": "Website swinburne-vn.edu.vn — Next.js + Payload CMS",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:standalone": "tsx scripts/start-standalone.ts",
    "clean": "rimraf .next",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed/index.ts",
    "mock-crm": "tsx scripts/mock-crm.ts",
    "check-env": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-redirects": "3.91.0",
    "@payloadcms/plugin-seo": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "clsx": "2.1.1",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "graphql": "16.11.0",
    "next": "16.4.6",
    "payload": "3.91.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.7",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "28.1.0",
    "pg": "8.16.3",
    "prettier": "3.6.2",
    "rimraf": "6.1.4",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
